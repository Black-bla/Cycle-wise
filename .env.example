# GEMINI_API_KEY: Required for Google Gemini AI models & multi-model failsafe cascade.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NVIDIA_API_KEY: Key for NVIDIA NIM Nemotron 3 Ultra / Super models.
# Endpoint: https://integrate.api.nvidia.com/v1
# Model: nvidia/nemotron-3-super-120b or nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"
NVIDIA_MODEL="nvidia/nemotron-3-super-120b"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# ANTHROPIC_API_KEY: Optional key for Anthropic Claude models via the Messages API.
# Endpoint: https://api.anthropic.com/v1/messages
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"
ANTHROPIC_MODEL="claude-sonnet-5"

# --- M-Pesa Daraja API (Safaricom) ---
# Powers the optional "Settle Balance Gap via M-Pesa" flow in the Active
# Exchanges > Escrow & Payment tab: when a barter cycle doesn't balance to
# exactly 100% (see the cycle's value_balance score), the small residual gap
# can be closed same-day via STK Push instead of a cash loan.
#
# Get free sandbox credentials at https://developer.safaricom.co.ke — create
# an app and enable the "Lipa Na M-Pesa Sandbox" (M-Pesa Express) product to
# get your Consumer Key & Consumer Secret.
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY="MY_MPESA_CONSUMER_KEY"
MPESA_CONSUMER_SECRET="MY_MPESA_CONSUMER_SECRET"
# Safaricom's published sandbox test shortcode & passkey — identical for every
# developer's sandbox account, safe to keep as-is for testing. Swap in your own
# Paybill/Till shortcode and passkey when you go to MPESA_ENV="production".
MPESA_SHORTCODE="174379"
MPESA_PASSKEY="bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919"
# Must be a public HTTPS URL Safaricom can reach — the app exposes
# POST /api/v1/mpesa/callback for this. In local dev, tunnel your server
# (e.g. `ngrok http 3000`) and set this to
# "https://<your-subdomain>.ngrok-free.app/api/v1/mpesa/callback".
MPESA_CALLBACK_URL="MY_MPESA_CALLBACK_URL"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Every provider key above (Gemini, NVIDIA, Anthropic, M-Pesa) is optional at
# runtime. The AI agent gracefully falls back through NVIDIA -> Gemini ->
# Anthropic -> a local deterministic extractor, and the M-Pesa flow falls back
# to a simulated sandbox provider, whenever a key is missing or left at its
# placeholder value. None of them are required to install dependencies or run
# `npm run build`.
